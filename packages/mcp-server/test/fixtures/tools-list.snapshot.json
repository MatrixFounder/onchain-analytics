  {
    "name": "onchain_dex_volume",
    "title": "DEX volume of a chain",
    "description": "Daily DEX trading volume of a CHAIN, from DeFiLlama — free and keyless. Returns the daily series in the requested window plus the vendor 24h/7d/30d/1y/all-time totals. Set includeSeries:false for the totals alone. This is volume TRADED, not value locked — use onchain_chain_tvl for TVL. Served on fewer chains than TVL is: call onchain_list_chains with capability \"dex.volume.history\" to see where.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "chain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1825
        },
        "includeSeries": {
          "type": "boolean"
        }
      },
      "required": [
        "chain"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "chain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "name": {
          "type": "string"
        },
        "window": {
          "type": "object",
          "properties": {
            "fromMs": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "toMs": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "days": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "fromMs",
            "toMs",
            "days"
          ],
          "additionalProperties": false
        },
        "series": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ts": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "volumeUsd": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "ts",
              "volumeUsd"
            ],
            "additionalProperties": false
          }
        },
        "points": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "gapDays": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "totals": {
          "type": "object",
          "properties": {
            "h24": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "d7": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "d30": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "d1y": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "allTime": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "h24",
            "d7",
            "d30",
            "d1y",
            "allTime"
          ],
          "additionalProperties": false
        },
        "truncated": {
          "type": "object",
          "properties": {
            "series": {
