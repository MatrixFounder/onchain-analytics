{
  "name": "onchain-error-alert",
  "description": null,
  "active": true,
  "nodes": [
    {
      "parameters": {
        "content": "## onchain-error-alert\nError Trigger → **Normalize Input** (Set: owns the error-payload→named-fields contract + the target `ChatID`, with fallbacks so nothing renders `undefined`) → Telegram. Set as the `errorWorkflow` for onchain-* workflows; fires a Telegram alert on any failure. To change the target chat or the message, edit **Normalize Input** — not the Telegram node.\n\n**HTML-escaping is load-bearing (L-4).** The Telegram node sends `parse_mode: HTML`, and the fields interpolated here are arbitrary vendor/runtime text. A raw `_` is an italic delimiter under Telegram's Markdown modes and a raw `<` breaks HTML mode — either way an unparseable entity means **400 and NO alert delivered**, i.e. the alerting path fails exactly when it is needed. `workflow_name` / `last_node` / `error_message` are escaped here (`&` first), and `error_message` is capped at 1500 chars so a long stack trace cannot blow the 4096-char message limit. Keep both when editing.\n\nOwner: onchain-intel.",
        "height": 524,
        "width": 768
      },
      "id": "sticky",
      "name": "Overview",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -48,
        -432
      ]
    },
    {
      "parameters": {},
      "id": "err_trig",
      "name": "On workflow error",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $('Normalize Input').first().json.ChatID }}",
        "text": "=🔴 onchain-intel: workflow FAILED\nWorkflow: {{ $('Normalize Input').first().json.workflow_name }}\nLast node: {{ $('Normalize Input').first().json.last_node }}\nError: {{ $('Normalize Input').first().json.error_message }}\nExecution: {{ $('Normalize Input').first().json.execution_id }} ({{ $('Normalize Input').first().json.execution_mode }})\nTime: {{ $('Normalize Input').first().json.alerted_at }}",
        "additionalFields": {
          "appendAttribution": false,
          "parse_mode": "HTML"
        }
      },
      "id": "tg_alert",
      "name": "Telegram alert",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        464,
        0
      ],
      "webhookId": "ed90f63e-31f6-43c7-8d2d-258ac6bab541",
      "credentials": {
        "telegramApi": {
          "id": "cMrsUr48jl2JVEUi",
          "name": "Onchain bot"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c-workflow-name",
              "name": "workflow_name",
              "value": "={{ ($('On workflow error').first().json.workflow?.name || 'unknown').toString().split('&').join('&amp;').split('<').join('&lt;').split('>').join('&gt;') }}",
              "type": "string"
            },
            {
              "id": "c-workflow-id",
              "name": "workflow_id",
              "value": "={{ $('On workflow error').first().json.workflow?.id || 'unknown' }}",
              "type": "string"
            },
            {
              "id": "c-last-node",
              "name": "last_node",
              "value": "={{ ($('On workflow error').first().json.execution?.lastNodeExecuted || '(unknown)').toString().split('&').join('&amp;').split('<').join('&lt;').split('>').join('&gt;') }}",
              "type": "string"
            },
            {
              "id": "c-error-message",
              "name": "error_message",
              "value": "={{ ($('On workflow error').first().json.execution?.error?.message || 'no message').toString().slice(0,1500).split('&').join('&amp;').split('<').join('&lt;').split('>').join('&gt;') }}",
              "type": "string"
            },
            {
              "id": "c-execution-id",
              "name": "execution_id",
              "value": "={{ $('On workflow error').first().json.execution?.id || 'n/a' }}",
              "type": "string"
            },
            {
              "id": "c-execution-url",
              "name": "execution_url",
              "value": "={{ $('On workflow error').first().json.execution?.url || '' }}",
              "type": "string"
            },
            {
              "id": "c-execution-mode",
              "name": "execution_mode",
              "value": "={{ $('On workflow error').first().json.execution?.mode || 'unknown' }}",
              "type": "string"
            },
            {
              "id": "c-alerted-at",
              "name": "alerted_at",
              "value": "={{ new Date().toISOString() }}",
              "type": "string"
            },
            {
              "id": "c-chat-id",
              "name": "ChatID",
              "value": 0,
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "id": "set-normalize",
      "name": "Normalize Input",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        224,
        0
      ]
    }
  ],
