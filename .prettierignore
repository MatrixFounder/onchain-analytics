# Shared Prettier ignore file for the onchain-intel monorepo (root, per ARCHITECTURE.md §6.4).
# Mirrors the `ignores` list in the root eslint.config.js: build output and dependency/coverage
# directories are never hand-formatted or checked — `dist/` is esbuild (tsup) output, not source.
dist/
node_modules/
coverage/

# pnpm's own lockfile format — never hand-formatted, and Prettier's YAML formatting doesn't match
# pnpm's writer (repo-wide `prettier --check .` would otherwise flag it on every install).
pnpm-lock.yaml

# Curated / generated / external content — not under the repo format gate:
# SoT research docs (Russian, curated by hand)
docs/onchain-analytics/
# generated research output — a workflow writes the prose chunks, the raw JSON and the
# build-report.mjs that assembles them; reformatting it would rewrite recorded evidence
# (added TASK-007, after running the check and reviewing the file list — BACKLOG blast-radius rule)
docs/dune-query-discovery/
# review artifacts from earlier runs
docs/reviews/
# n8n export.sh owns the JSON format here
n8n-workflows/
# imported source dialogs
reference/
# hand-authored SQL docs
sql/
# agent prompt files (loaded as system prompts, curated)
CLAUDE.md
CLAUDE.n8n.md
CLAUDE.local.md
CLAUDE.agentic.md
# framework dir (partially symlinked/external)
.agent/
# run-feedback ledgers & backlog — CLI-written, never formatter-touched
docs/KNOWN_ISSUES.md
docs/issues/
docs/BACKLOG.md
# the work-item RECORDS, sibling of docs/issues/ — omitted here until WI-20…WI-23 turned CI red
# (2026-07-30). Record bodies are evidence: they quote captured output and hand-built tables, and
# the run-feedback CLI (WI-23) writes them, so a formatter pass would rewrite them on every filing.
docs/backlog/
docs/feedback/
# generated chain registry — scripts/sync-chain-registry.ts owns its byte format (R-49c determinism)
packages/core/src/chain/registry.data.json
# The two TASK-011 generated artifacts, for the same reason: their generators own the bytes and a
# test compares them byte for byte, so a prettier pass would fail the gate on an unchanged registry.
#   snapshot   — scripts/snapshot-tools.ts    → test/tools-list-contract.test.ts (R-125)
#   inventory  — scripts/gen-tool-inventory.ts → test/tool-inventory-in-sync.test.ts (R-114)
#
# **Both are also listed in `packages/mcp-server/.prettierignore`, and both listings are needed.**
# Prettier reads only the ignore file at its CWD — nested ones are not consulted — so the package
# file covers `pnpm --filter … format:check` and this one covers the root `prettier --check .` that
# CI actually runs (.github/workflows/ci.yml). Listing them locally alone is what turned this branch
# red, the same way omitting docs/backlog/ here did on 2026-07-30 (see above). The duplication is
# safe because it is self-detecting: a third generated artifact listed only in the package file
# fails the root gate immediately, by name.
packages/mcp-server/test/fixtures/tools-list.snapshot.json
packages/mcp-server/tool-inventory.json
# transient python artefacts — git ignores them, prettier must too, otherwise running pytest at
# the repo root turns `pnpm format:check` red for a file nobody authored
.pytest_cache/
__pycache__/
