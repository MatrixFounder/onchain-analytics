# >>> agentic-development framework >>>
# Managed by the agentic-development installer. Do not edit between the markers.

# Framework content (symlink or local copy) and installer state.
/.agentic-development
/.agentic-installer-state.json

# Framework components.
/.agent/skills/*
/.agent/workflows/*
/.agent/tools
/.agent/rules
/.agent/sessions
/.agent/feedback
/System
/.claude/skills/*
/.claude/commands/*
/.claude/agents/*
/.claude/hooks
/.claude/settings.json
/.claude/settings.local.json

# Claude bridge files (gitignored — they import the framework).
/CLAUDE.agentic.md
/CLAUDE.local.md

# .claude runtime locks.
/.claude/*.lock

# Project-local entries (kept in version control).
!/.agent/skills/vm-deploy
!/.claude/skills/vm-deploy
# <<< end agentic-development framework <<<

# --- Project (non-framework) ---

# External n8n-skills plugin — symlink-referenced, not vendored (like /.agentic-development above).
# Its per-skill links under .agent/skills/ and .claude/skills/ need no rule of their own: those two
# directories are ignored wholesale by the managed block, and the installer un-ignores only entries
# a fresh clone could still resolve — which these, resolving into ~/ExternalTools, cannot.
/.n8n-skills

# OS / editor cruft
.DS_Store
*.swp

# Secrets — ADR-001 D10: .env is chmod 0600 and MUST never be committed
.env
.env.*
!.env.example
# MCP config holds live n8n API keys (N8N_API_KEY / Bearer) in plaintext — never commit
.mcp.json
.mcp.local.json

# Node / TypeScript build output
node_modules/
dist/
*.tsbuildinfo
coverage/

# Local state — DB-SCHEMA-CONCEPT §1.10: all state lives in DATA_DIR; SQLite files never committed
/DATA_DIR/
# Eval report from `ONCHAIN_EVAL_JSON=report.json pnpm eval` (documented in eval/run.mjs). It is the
# output of a run against real providers on the operator's own .env: every result row carries the
# full `structured` payload and up to 200 chars of each error text. No secret can reach it today
# (the free contour only, and key-bearing error paths are redacted), but this repo is Apache-2.0 and
# meant to be published, so it should never ride in on a `git add -A`. It is ALSO listed in the
# documentation gate's EXCLUDED_FILES — independently, because that walk reads the filesystem and
# never consults git.
/packages/mcp-server/report.json
*.db
*.sqlite
*.sqlite3
*-wal
*-shm

# Python bytecode (import_with_relink.py is imported directly by tests/harnesses)
__pycache__/
*.py[cod]
