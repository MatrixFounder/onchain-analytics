  {
    "name": "onchain_list_chains",
    "title": "List supported chains",
    "description": "Discover which chains this engine knows and which capabilities are actually served on each. Use it to find the right `chain` value for the other tools, or to check where a capability is available. Makes no network calls.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "family": {
          "type": "string",
          "enum": [
            "evm",
            "svm",
            "move",
            "cosmos",
            "utxo",
            "other"
          ]
        },
        "capability": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "minTvlUsd": {
          "type": "number",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 200
        }
      },
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "chains": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "slug": {
                "type": "string"
              },
              "caip2": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "family": {
                "type": "string"
              },
              "nativeSymbol": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "tvlUsdAtRegistrySync": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "slug",
              "caip2",
              "name",
              "family",
              "nativeSymbol",
              "capabilities",
              "tvlUsdAtRegistrySync"
            ],
            "additionalProperties": false
          }
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "registrySyncedAt": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "chains",
        "total",
        "registrySyncedAt"
